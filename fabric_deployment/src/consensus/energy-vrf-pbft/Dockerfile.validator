FROM golang:1.21-bookworm AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath \
    -o /out/lsb-validatord \
    ./cmd/validatord


FROM alpine:3.20

RUN addgroup -S lsb && adduser -S -G lsb lsb

COPY --from=builder \
    /out/lsb-validatord \
    /usr/local/bin/lsb-validatord

USER lsb

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/lsb-validatord"]
